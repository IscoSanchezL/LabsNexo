rules_version = '2';
// Pega este contenido en Firebase → Firestore Database → Rules → Publish.
// Cambia la lista de docentes (los mismos valores de CLOUD en src/config.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isTeacher() { return verified() && request.auth.token.email.lower() in ['docente1@ejemplo.com']; }
    function isSchool() { return verified() && request.auth.token.email.lower().matches('.*@gi\\.edu\\.co$'); }

    match /students/{uid} {
      allow read: if isTeacher() || (isSchool() && request.auth.uid == uid);
      allow create, update: if isSchool() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'nickname', 'avatar', 'grade', 'levels', 'badges', 'exam', 'updatedAt'])
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.grade is int && request.resource.data.grade >= 3 && request.resource.data.grade <= 6
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 16;
      allow delete: if isTeacher();
    }
  }
}
